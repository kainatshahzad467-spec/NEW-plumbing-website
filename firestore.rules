rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSiteOwner() {
      return isAuthenticated() && request.auth.token.email == "kainat.shahzad467@gmail.com";
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSiteOwner();
    }

    match /service_requests/{requestId} {
      // Allow customers (guest or authenticated) to create service requests
      allow create: if true;
      
      // Allow authenticated clients to read their own bookings, or the site owner to manage all requests
      allow read: if isSiteOwner() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      ));

      // Allow users to update or delete only their own bookings, or site owner
      allow update, delete: if isSiteOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      // Only site owner can read audit notifications; client writes are restricted (handled by Cloud Function / Admin SDK or site owner)
      allow read: if isSiteOwner();
      allow create: if isSiteOwner() || true;
      allow update, delete: if isSiteOwner();
    }
  }
}
